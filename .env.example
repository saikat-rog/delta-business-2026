# Smart Driver API Backend Configuration
# In local development: http://localhost:5050
# In production: https://api.yourdomain.com
VITE_API_URL=http://localhost:5050

# Analytics (use your production IDs; leave blank to disable a provider)
# Google Analytics 4 Measurement ID, for example: G-XXXXXXXXXX
VITE_GOOGLE_ANALYTICS_ID=
# Meta Pixel ID, for example: 123456789012345
VITE_META_PIXEL_ID=
